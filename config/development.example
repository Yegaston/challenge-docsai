# Example values for local development only.
# Database password is fixed in Compose: support-dev-password (never production).
# Export values as shown in README.md; this file is not loaded automatically.
# Authentication variables are backend-only. Never use VITE_* for secrets.
DEMO_EMAIL=
# 12–256 characters; initial seed only, not a password-rotation mechanism.
DEMO_PASSWORD=
# Optional separate human-support login; set BOTH or leave BOTH blank.
# Compose maps these to API-only SUPPORT_EMAIL and SUPPORT_PASSWORD.
DEMO_SUPPORT_EMAIL=
# 12–256 characters; initial seed only, not password rotation.
DEMO_SUPPORT_PASSWORD=
# At least 32 random bytes. Keep stable across restarts unless invalidating tokens.
JWT_SECRET=
DB_PORT=5432
# Optional backend-only key; missing key disables analysis, not auth/tickets.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.3-flash
