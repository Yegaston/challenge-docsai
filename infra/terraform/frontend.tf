# Frontend serving: private encrypted S3 SPA bucket reachable only through
# CloudFront OAC, plus /api and /api/* behaviors routing to the ALB origin.
# Terraform manages no bucket objects; the Floci workflow uploads the built SPA.
resource "aws_s3_bucket" "frontend" {
  bucket = "${var.name}-frontend"
}

resource "aws_s3_bucket_public_access_block" "frontend" {
  bucket                  = aws_s3_bucket.frontend.id
  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

resource "aws_s3_bucket_server_side_encryption_configuration" "frontend" {
  bucket = aws_s3_bucket.frontend.id
  rule {
    apply_server_side_encryption_by_default {
      sse_algorithm = "AES256"
    }
  }
}

resource "aws_cloudfront_origin_access_control" "spa" {
  name                              = "${var.name}-spa-oac"
  origin_access_control_origin_type = "s3"
  signing_behavior                  = "always"
  signing_protocol                  = "sigv4"
}

# Explicit custom cache policies: managed policies are poorly modeled locally.
resource "aws_cloudfront_cache_policy" "spa" {
  name        = "${var.name}-spa-cache"
  min_ttl     = 0
  default_ttl = 0
  max_ttl     = 31536000
  parameters_in_cache_key_and_forwarded_to_origin {
    cookies_config { cookie_behavior = "none" }
    headers_config { header_behavior = "none" }
    query_strings_config { query_string_behavior = "none" }
  }
}

# Zero TTL on every axis: no API response is cached at the edge, while
# cookies, query strings and authorization/content-type headers reach origin.
resource "aws_cloudfront_cache_policy" "api_no_cache" {
  name        = "${var.name}-api-no-cache"
  min_ttl     = 0
  default_ttl = 0
  max_ttl     = 0
  parameters_in_cache_key_and_forwarded_to_origin {
    cookies_config { cookie_behavior = "all" }
    headers_config {
      header_behavior = "whitelist"
      headers {
        items = ["Authorization", "Content-Type", "Origin"]
      }
    }
    query_strings_config { query_string_behavior = "all" }
  }
}

resource "aws_cloudfront_function" "spa_rewrite" {
  name    = "${var.name}-spa-rewrite"
  runtime = "cloudfront-js-1.0"
  comment = "Viewer request: resolve extensionless SPA client routes to index.html."
  code    = file("${path.module}/spa-rewrite.js")
  # Explicit for clarity; AWS defaults publish=true.
  publish = true
  # Floci 2.2.0 returns the stored function code base64-encoded while the AWS
  # provider compares it against the plain-text config, so every emulator
  # refresh looks like a code change and Floci's PublishFunction then rejects
  # the update (InvalidIfMatchVersion: no If-Match support). The checked-in
  # local-only override infra/floci/local_override.tf (applied by the guarded
  # wrapper inside the isolated infra/floci/work copy) ignores that drift in
  # emulation only; the AWS root stays drift-aware and normal AWS applies
  # can update and publish changes to spa-rewrite.js.
}

locals {
  # Local emulation reaches the ALB through the fixed Floci container alias
  # (compose.floci.yaml) over plain HTTP: Floci's ALB listener is Host-agnostic
  # and the emulator allowlists exactly this private origin host. The
  # autogenerated ALB DNS is deliberately NOT used locally: it would require a
  # Floci restart (which wipes all emulated state) after every apply.
  # AWS requires the certificate-matching hostname: DNS must point it at the
  # ALB before any deployment (docs DNS prerequisite).
  api_origin_domain = var.local_emulation ? var.local_api_origin_host : var.api_hostname
  external_origin   = "https://${aws_cloudfront_distribution.frontend.domain_name}"
}

resource "aws_cloudfront_distribution" "frontend" {
  enabled = true
  comment = "${var.name} SPA delivery with /api/* ALB origin"

  origin {
    domain_name              = aws_s3_bucket.frontend.bucket_regional_domain_name
    origin_id                = "spa"
    origin_access_control_id = aws_cloudfront_origin_access_control.spa.id
  }
  origin {
    domain_name = local.api_origin_domain
    origin_id   = "api"
    custom_origin_config {
      http_port              = 80
      https_port             = 443
      origin_protocol_policy = var.local_emulation ? "http-only" : "https-only"
      origin_ssl_protocols   = ["TLSv1.2"]
    }
  }

  dynamic "ordered_cache_behavior" {
    for_each = ["/api", "/api/*"]
    content {
      path_pattern           = ordered_cache_behavior.value
      target_origin_id       = "api"
      allowed_methods        = ["GET", "HEAD", "OPTIONS", "PUT", "POST", "PATCH", "DELETE"]
      cached_methods         = ["GET", "HEAD"]
      viewer_protocol_policy = "https-only"
      cache_policy_id        = aws_cloudfront_cache_policy.api_no_cache.id
      compress               = true
    }
  }
  default_cache_behavior {
    target_origin_id       = "spa"
    allowed_methods        = ["GET", "HEAD", "OPTIONS"]
    cached_methods         = ["GET", "HEAD"]
    viewer_protocol_policy = "redirect-to-https"
    cache_policy_id        = aws_cloudfront_cache_policy.spa.id
    function_association {
      event_type   = "viewer-request"
      function_arn = aws_cloudfront_function.spa_rewrite.arn
    }
  }

  # No custom_error_response: API 401/403/404/5xx reach the browser unchanged.
  viewer_certificate {
    cloudfront_default_certificate = true
    minimum_protocol_version       = "TLSv1.2_2021"
  }
  restrictions {
    geo_restriction {
      restriction_type = "none"
    }
  }
}

# Only this distribution's ARN may read the private bucket through OAC.
resource "aws_s3_bucket_policy" "frontend" {
  bucket = aws_s3_bucket.frontend.id
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Sid       = "AllowCloudFrontOACRead"
      Effect    = "Allow"
      Principal = { Service = "cloudfront.amazonaws.com" }
      Action    = "s3:GetObject"
      Resource  = "arn:aws:s3:::${aws_s3_bucket.frontend.id}/*"
      Condition = { StringEquals = { "AWS:SourceArn" = aws_cloudfront_distribution.frontend.arn } }
    }]
  })
}
